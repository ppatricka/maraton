<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.pageTitle ? pageTitle + ' · Maratón' : 'Maratón' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="page">
  <header class="topbar">
    <a class="logo" href="/">maratón</a>
    <% if (user) { %>
    <nav class="nav" aria-label="Main">
      <a href="/" class="pill <%= path === '/' ? 'pill-active' : '' %>">Diary</a>
